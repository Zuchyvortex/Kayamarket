// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  passwordHash  String
  firstName     String
  lastName      String
  phoneNumber   String?
  profileImage  String?
  status        UserStatus @default(ACTIVE)
  lastLogin     DateTime?
  role          Role       @default(CUSTOMER)
  addresses     Address[]
  orders        Order[]
  wishlist      Wishlist[]
  rider         Rider?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  CUSTOMER
  ADMIN
  RIDER
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street     String
  city       String
  state      String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  isFeatured  Boolean   @default(false)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id           String      @id @default(uuid())
  name         String
  slug         String      @unique
  description  String
  price        Decimal     @db.Decimal(10, 2)
  inventory    Int         @default(0)
  sku          String?     @unique
  categoryId   String
  category     Category    @relation(fields: [categoryId], references: [id])
  images       String[]
  isActive     Boolean     @default(true)
  isFeatured   Boolean     @default(false)
  isBestSeller Boolean     @default(false)
  isNewArrival Boolean     @default(false)
  orderItems   OrderItem[]
  wishlistedBy Wishlist[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

enum OrderStatus {
  ORDER_PLACED
  ORDER_CONFIRMED
  PREPARING
  PACKED
  ASSIGNED_TO_RIDER
  OUT_FOR_DELIVERY
  ARRIVING_SOON
  DELIVERED
  COMPLETED
  CANCELLED
}

enum VehicleType {
  MOTORCYCLE
  CAR
  VAN
}

enum RiderStatus {
  ACTIVE
  OFFLINE
  SUSPENDED
}

model Rider {
  id                  String      @id @default(uuid())
  riderId             String      @unique
  fullName            String
  phoneNumber         String
  email               String      @unique
  passwordHash        String?
  address             String
  vehicleType         VehicleType @default(MOTORCYCLE)
  vehicleRegistration String
  profilePhoto        String?
  status              RiderStatus @default(ACTIVE)
  notes               String?
  userId              String?     @unique
  user                User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders              Order[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model Order {
  id                String               @id @default(uuid())
  orderNumber       String               @unique
  userId            String?
  user              User?                @relation(fields: [userId], references: [id])
  customerName      String
  customerPhone     String?
  status            OrderStatus          @default(ORDER_PLACED)
  totalAmount       Decimal              @db.Decimal(10, 2)
  deliveryFee       Decimal              @db.Decimal(10, 2)
  deliveryAddress   String
  deliveryDate      String?
  deliveryTime      String?
  paymentMethod     String?              @default("Bank Transfer")
  paymentStatus     String?              @default("PAID")
  riderId           String?
  rider             Rider?               @relation(fields: [riderId], references: [id])
  customerConfirmed Boolean              @default(false)
  confirmedAt       DateTime?
  signatureType     String?
  signatureData     String?
  proofCustomerName String?
  notes             String?
  items             OrderItem[]
  timeline          OrderTimelineEvent[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model OrderTimelineEvent {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  title       String
  description String?
  updatedBy   String?
  createdAt   DateTime    @default(now())
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  productName String?
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int
}

model Wishlist {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model HomepageConfig {
  id                 String   @id @default("default")
  heroBannerImage    String?
  heroBannerTitle    String?
  heroBannerSubtitle String?
  heroBannerLink     String?
  promotionalBanners String[]
  videoUrl           String?
  announcementText   String?
  announcementActive Boolean  @default(false)
  flashSaleActive    Boolean  @default(false)
  flashSaleEndTime   DateTime?
  updatedAt          DateTime @updatedAt
}
