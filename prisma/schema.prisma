// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  passwordHash  String
  firstName     String
  lastName      String
  username      String?
  phoneNumber   String?
  altPhoneNumber String?
  address       String?
  city          String?
  state         String?
  profileImage  String?
  status        UserStatus      @default(ACTIVE)
  lastLogin     DateTime?
  role          Role            @default(CUSTOMER)
  addresses     Address[]
  orders        Order[]
  wishlist      Wishlist[]
  productReviews ProductReview[]
  riderReviews   RiderReview[]
  invoices      Invoice[]
  notifications Notification[]
  rider         Rider?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  CUSTOMER
  ADMIN
  RIDER
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street     String
  city       String
  state      String
  postalCode String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  imageUrl    String?
  isFeatured  Boolean   @default(false)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Farmer {
  id             String              @id @default(uuid())
  name           String
  phone          String?
  email          String?
  address        String?
  commissionRate Decimal             @default(5.00) @db.Decimal(5, 2)
  notes          String?
  products       Product[]
  transactions   FarmerTransaction[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model Product {
  id                String              @id @default(uuid())
  name              String
  slug              String              @unique
  description       String
  price             Decimal             @db.Decimal(10, 2)
  costPrice         Decimal             @default(0) @db.Decimal(10, 2)
  inventory         Int                 @default(0)
  minStockThreshold Int                 @default(5)
  sku               String?             @unique
  categoryId        String
  category          Category            @relation(fields: [categoryId], references: [id])
  farmerId          String?
  farmer            Farmer?             @relation(fields: [farmerId], references: [id], onDelete: SetNull)
  farmerName        String?
  farmerTransactions FarmerTransaction[]
  images            String[]
  isActive          Boolean             @default(true)
  isFeatured        Boolean             @default(false)
  isBestSeller      Boolean             @default(false)
  isNewArrival      Boolean             @default(false)
  orderItems        OrderItem[]
  wishlistedBy      Wishlist[]
  reviews           ProductReview[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
}

enum OrderStatus {
  ORDER_PLACED
  ORDER_CONFIRMED
  PREPARING
  PACKED
  ASSIGNED_TO_RIDER
  OUT_FOR_DELIVERY
  ARRIVING_SOON
  DELIVERED
  COMPLETED
  CANCELLED
}

enum VehicleType {
  MOTORCYCLE
  CAR
  VAN
}

enum RiderStatus {
  ACTIVE
  OFFLINE
  SUSPENDED
}

model Rider {
  id                  String        @id @default(uuid())
  riderId             String        @unique
  fullName            String
  username            String?
  phoneNumber         String
  email               String        @unique
  passwordHash        String?
  address             String
  vehicleType         VehicleType   @default(MOTORCYCLE)
  vehicleRegistration String
  emergencyContact    String?
  profilePhoto        String?
  status              RiderStatus   @default(ACTIVE)
  notes               String?
  userId              String?       @unique
  user                User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders              Order[]
  reviews             RiderReview[]
  remarks             RiderRemark[]
  notifications       Notification[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model RiderRemark {
  id        String   @id @default(uuid())
  riderId   String
  rider     Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  type      String   // "COMMENDATION" | "IMPROVEMENT" | "NOTE"
  content   String
  createdBy String   @default("Admin")
  createdAt DateTime @default(now())
}

model FarmerTransaction {
  id           String   @id @default(uuid())
  farmerId     String
  farmer       Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  quantity     Int
  unitCost     Decimal  @db.Decimal(10, 2)
  totalCost    Decimal  @db.Decimal(10, 2)
  commission   Decimal  @default(0) @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime @default(now())
}

model Order {
  id                String               @id @default(uuid())
  orderNumber       String               @unique
  userId            String?
  user              User?                @relation(fields: [userId], references: [id])
  customerName      String
  customerPhone     String?
  customerAltPhone  String?
  status            OrderStatus          @default(ORDER_PLACED)
  subtotal          Decimal?             @db.Decimal(10, 2)
  deliveryFee       Decimal              @db.Decimal(10, 2)
  totalAmount       Decimal              @db.Decimal(10, 2)
  riderEarnings     Decimal?             @db.Decimal(10, 2)
  platformShare     Decimal?             @db.Decimal(10, 2)
  deliveryAddress   String
  deliveryDate      String?
  deliveryTime      String?
  paymentMethod     String?              @default("Bank Transfer")
  paymentStatus     String?              @default("PAID")
  riderId           String?
  rider             Rider?               @relation(fields: [riderId], references: [id])
  customerConfirmed Boolean              @default(false)
  confirmedAt       DateTime?
  signatureType     String?
  signatureData     String?
  proofCustomerName String?
  notes             String?
  items             OrderItem[]
  timeline          OrderTimelineEvent[]
  riderReview       RiderReview?
  productReviews    ProductReview[]
  invoice           Invoice?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model OrderTimelineEvent {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  title       String
  description String?
  updatedBy   String?
  createdAt   DateTime    @default(now())
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  productName String?
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int
}

model ProductReview {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int      @default(5)
  title       String?
  comment     String
  displayName String
  isApproved  Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model RiderReview {
  id                 String   @id @default(uuid())
  riderId            String
  rider              Rider    @relation(fields: [riderId], references: [id], onDelete: Cascade)
  orderId            String   @unique
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating             Int      @default(5)
  comment            String?
  deliveryExperience String?
  createdAt          DateTime @default(now())
}

model Invoice {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String
  customerEmail   String?
  customerPhone   String?
  customerAddress String
  subtotal        Decimal  @db.Decimal(10, 2)
  deliveryFee     Decimal  @db.Decimal(10, 2)
  totalAmount     Decimal  @db.Decimal(10, 2)
  paymentMethod   String?  @default("Bank Transfer")
  paymentStatus   String?  @default("PAID")
  riderName       String?
  riderIdCode     String?
  orderDate       DateTime
  deliveryDate    DateTime @default(now())
  createdAt       DateTime @default(now())
}

model Notification {
  id         String   @id @default(uuid())
  targetRole Role     @default(ADMIN)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  riderId    String?
  rider      Rider?   @relation(fields: [riderId], references: [id], onDelete: Cascade)
  title      String
  message    String
  link       String?
  type       String?  @default("SYSTEM")
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Wishlist {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model HomepageConfig {
  id                 String    @id @default("default")
  heroBannerImage    String?
  heroBannerTitle    String?
  heroBannerSubtitle String?
  heroBannerLink     String?
  promotionalBanners String[]
  videoUrl           String?
  announcementText   String?
  announcementActive Boolean   @default(false)
  flashSaleActive    Boolean   @default(false)
  flashSaleEndTime   DateTime?
  updatedAt          DateTime  @updatedAt
}

model SystemSetting {
  id                    String   @id @default("default")
  deliveryFee           Decimal  @default(4000) @db.Decimal(10, 2)
  riderEarnings         Decimal  @default(2000) @db.Decimal(10, 2)
  farmerCommissionRate  Decimal  @default(5.00) @db.Decimal(5, 2)
  updatedAt             DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ComboBundle {
  id                 String   @id @default(uuid())
  name               String
  slug               String   @unique
  description        String
  price              Decimal  @db.Decimal(10, 2)
  originalPrice      Decimal? @db.Decimal(10, 2)
  discountPercentage Int      @default(0)
  image              String
  includedProducts   String[] @default([])
  displayOrder       Int      @default(0)
  isVisible          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
